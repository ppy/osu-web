{
  "name": "ppy/osu-web",
  "description": "osu!web",
  "type": "project",
  "homepage": "https://new.ppy.sh",
  "license": "AGPL-3.0",
  "support": {
    "email": "support@ppy.sh",
    "issues": "https://github.com/ppy/osu-web/issues"
  },
  "require": {
    "ext-ds": "*",
    "ext-redis": "*",
    "bacon/bacon-qr-code": "^3.0",
    "chaseconey/laravel-datadog-helper": ">=1.2.0",
    "egulias/email-validator": "*",
    "elasticsearch/elasticsearch": "^7.17.x-dev",
    "ezyang/htmlpurifier": "^4.19.0",
    "firebase/php-jwt": "^7.1.0",
    "graham-campbell/github": "^13.1.1",
    "guzzlehttp/guzzle": "*",
    "itsgoingd/clockwork": "^5.1",
    "knuckleswtf/scribe": "^5.11.0",
    "laravel/framework": "^13.26.1",
    "laravel/helpers": "^1.8.3",
    "laravel/octane": "^2.19.1",
    "laravel/passport": "^13.7.6",
    "laravel/slack-notification-channel": "^3.10.0",
    "laravel/tinker": "^3.0.2",
    "league/commonmark": "^2.9.0",
    "league/flysystem-aws-s3-v3": "*",
    "league/fractal": "*",
    "league/oauth2-github": "^3.1",
    "league/oauth2-server": "^9.4.1",
    "maennchen/zipstream-php": "^3.2.2",
    "mariuzzo/laravel-js-localization": "^2.1.0",
    "matomo/device-detector": "^6.4",
    "paypal/paypal-checkout-sdk": "*",
    "reedware/laravel-relation-joins": "^9.0.1",
    "romanzipp/laravel-turnstile": "^1.3",
    "sentry/sentry-laravel": "^4.27.0",
    "shopify/shopify-api": "^6.1.1",
    "spomky-labs/otphp": "^11.3",
    "symfony/yaml": "*",
    "tightenco/ziggy": "^2.6.4",
    "xsolla/xsolla-sdk-php": "*"
  },
  "require-dev": {
    "beyondcode/laravel-query-detector": "^2.3.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "laravel/dusk": "^8.6.0",
    "mockery/mockery": "*",
    "nunomaduro/collision": "^8.9.5",
    "phpunit/phpunit": "^12.5.33",
    "scriptfusion/pip": "^3.6.0",
    "slevomat/coding-standard": "^8.15",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.0"
    },
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": false
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  }
}
