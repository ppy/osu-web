{
  "compilerOptions": {
    "experimentalDecorators": true,
    "sourceMap": true,
    "jsx": "react",
    "lib": ["es2020", "dom", "dom.iterable"],
    "module": "es2020",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "paths": {
      "*": ["../../resources/js/*"]
    },
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "target": "es2015",
  },
  "include": [
    "../../resources/js",
    "../../resources/builds/ziggy.d.ts",
    ".",
  ]
}
